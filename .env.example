# 深币实例配置模板 — 复制为 .env 后按用户修改
# 多实例：每个用户独立目录 + 独立 .env + 独立 FLASK_PORT

# ── Deepcoin API（每用户一套，切勿共用）──
DEEPCOIN_API_KEY=
DEEPCOIN_API_SECRET=
DEEPCOIN_PASSPHRASE=

# ── Webhook（TradingView 告警 secret，建议每用户不同）──
WEBHOOK_SECRET=change_me_user_secret

# ── Telegram 通知（与 Binance 系统共用同一 Bot）──
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── 钉钉（已废弃，改用 TG）──
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=

# ── API 限流（建议 60-90 req/min，根源避免限流）──
API_BUDGET_PER_MIN=60
API_BUDGET_SOFT_RATIO=0.75
API_SILENCE_SEC=900
API_MIN_GAP_SEC=0.4
REST_MIN_INTERVAL_SEC=2.0
REST_GLOBAL_MIN_INTERVAL_SEC=1.5
DEEPCOIN_REST_MIN_GAP_SEC=1.5
OPEN_ORDERS_CACHE_TTL_SEC=45

# ── 合约符号（仅 ETH）──
DEEPCOIN_SYMBOLS=ETH-USDT-SWAP

# ── Webhook（TradingView 告警 secret，建议每用户不同）──
WEBHOOK_SECRET=change_me_user_secret

# ── 网关（多实例必改端口，例如 5004 / 5005 / 5006）──
FLASK_HOST=0.0.0.0
FLASK_PORT=5005

# ── 可选：实例标识（写入日志/health 备注，便于区分）──
INSTANCE_LABEL=deepcoin
